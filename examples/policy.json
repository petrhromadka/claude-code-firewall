{
  "$schema": "https://raw.githubusercontent.com/petrhromadka/claude-code-firewall/main/schema/policy.schema.json",
  "mode": "enforce",
  "log_allowed": true,
  "rules": [
    {
      "id": "no-env-file",
      "tools": [
        "Read",
        "Edit",
        "MultiEdit",
        "Write",
        "NotebookEdit"
      ],
      "field": "file_path",
      "glob": "**/.env*",
      "unless_glob": "**/.env.example",
      "decision": "deny",
      "reason": "Reading or editing .env files is disabled."
    },
    {
      "id": "no-env-search",
      "tools": [
        "Grep",
        "Glob"
      ],
      "field": "*",
      "glob": "**/.env*",
      "unless_glob": "**/.env.example",
      "decision": "deny",
      "reason": "Searching .env files is disabled."
    },
    {
      "id": "confirm-env-shell",
      "tools": [
        "Bash",
        "PowerShell"
      ],
      "field": "command",
      "regex": "(?i)\\.env\\b(?!\\.example)",
      "decision": "ask",
      "reason": "This shell command mentions a .env file."
    },
    {
      "id": "confirm-push",
      "tools": [
        "Bash",
        "PowerShell"
      ],
      "field": "command",
      "regex": "(?i)\\bgit\\b[^;&|\\n]*\\bpush\\b",
      "decision": "ask",
      "reason": "Confirm git push."
    },
    {
      "id": "confirm-rm-rf",
      "tools": [
        "Bash"
      ],
      "field": "command",
      "regex": "\\brm\\b(?=[^;&|\\n]*\\s-[a-zA-Z]*[rR])(?=[^;&|\\n]*\\s-[a-zA-Z]*f)",
      "decision": "ask",
      "reason": "Confirm recursive forced delete."
    }
  ],
  "tests": [
    {
      "tool": "Read",
      "input": {"file_path": "/home/me/app/.env"},
      "expect": "deny"
    },
    {
      "tool": "Edit",
      "input": {"file_path": "C:\\Users\\me\\app\\.env.local"},
      "expect": "deny"
    },
    {
      "tool": "Read",
      "input": {"file_path": "/home/me/app/.env.example"},
      "expect": "allow"
    },
    {
      "tool": "Grep",
      "input": {"pattern": "API_KEY", "path": "/home/me/app/.env"},
      "expect": "deny"
    },
    {
      "tool": "Grep",
      "input": {"pattern": "TODO", "path": "src"},
      "expect": "allow"
    },
    {
      "tool": "Bash",
      "input": {"command": "cat .env"},
      "expect": "ask"
    },
    {
      "tool": "Bash",
      "input": {"command": "cp .env.example config.ini"},
      "expect": "allow"
    },
    {
      "tool": "Bash",
      "input": {"command": "cd app && git push origin feature"},
      "expect": "ask"
    },
    {
      "tool": "Bash",
      "input": {"command": "rm -r -f build"},
      "expect": "ask"
    },
    {
      "tool": "Bash",
      "input": {"command": "rm -r build && git status"},
      "expect": "allow"
    }
  ]
}
